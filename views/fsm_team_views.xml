<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_team_tree" model="ir.ui.view">
        <field name="name">fsm.team.tree</field>
        <field name="model">fsm.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="lead_user_id"/>
                <field name="warehouse_id"/>
                <field name="skill_level"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fsm_team_form" model="ir.ui.view">
        <field name="name">fsm.team.form</field>
        <field name="model">fsm.team</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(planning.planning_action_schedule_by_resource)d"
                            type="action" string="Open Technician Planning"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Technician membership and working times are managed as
                        dated, published shifts in Planning. This record keeps
                        the operational team identity, capabilities, warehouse,
                        vehicles, and reporting configuration.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="warehouse_id"/>
                        <field name="skill_level"/>
                        <field name="lead_user_id"/>
                    </group>
                    <notebook>
                        <page string="Planning Roster Bridge">
                            <div class="alert alert-warning" role="alert">
                                During the transition, changes here propagate
                                technician-team assignments to Planning from
                                the change date forward. Published Planning
                                shifts remain the availability source.
                            </div>
                            <field name="member_ids" string="Default Technicians"/>
                        </page>
                        <page string="Vehicles">
                            <field name="vehicle_ids"/>
                        </page>
                        <page string="Capabilities">
                            <field name="capable_task_type_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fsm_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">fsm.team</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fsm_team" name="Teams" parent="industry_fsm.fsm_menu_settings" action="action_fsm_team" sequence="30"/>
</odoo>
